<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<appSettings>

		<!-- Modbus Configuration -->
		<add key="ModbusIP" value="127.0.0.1"/>
		<add key="ModbusPort" value="502"/>
		<add key="ModbusUnitId" value="1"/>

		<!-- MQTT Configuration -->
		<add key="MqttIP" value="127.0.0.1"/>
		<add key="MqttPort" value="1883"/>

		<!-- MQTT Topics -->
		<add key="TemperatureTopic" value="TempTopic"/>
		<add key="TorqueTopic" value="TorqueTopic"/>
		<add key="StatusTopic" value="StatusTopic"/>
		<add key="AngleTopic" value="AngleTopic"/>
		<add key="CyclesStopTopic" value="CyclesStopTopic"/>

	</appSettings>
	<connectionStrings>

		<add name="ADBConnection"
     connectionString="Data Source=SUCHITA\SQLEXPRESS;Initial Catalog=ADB;Integrated Security=True;TrustServerCertificate=True"
     providerName="Microsoft.Data.SqlClient" />

	</connectionStrings>

</configuration>